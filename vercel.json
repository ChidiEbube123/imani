{
  "version": 2,
  "builds": [
    {
      "src": "govtrust_mvp_v2/wsgi.py",
      "use": "@vercel/python",
      "config": {  "maxLambdaSize": "250mb", "runtime": "python3.9" }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles_build"
      } 
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "govtrust_mvp_v2/wsgi.py"
      
    }
  ]
}
